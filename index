            { id: 'ld_1', actionable: false, status: 'todo', categories: ['ld'], categoryLabels: ['Level Design'], categoryLabelsZh: ['关卡设计'], title: 'Signage & Path Confusion', titleZh: '路线指引与迷路', desc: 'Gear Track open sections are too dark/lack cues. Players drove wrong way at Track 3 start. Distracted by first appearance of Rainbow Road. Recommend adding fog/mist to lowest ground to signal death planes.', descZh: '齿轮赛道开放区域太暗且缺乏指引。玩家在Track 3起点开反。被首次登场的彩虹赛道分散注意力。建议在底层加雾气以提示死亡边界。' },
            { id: 'ld_2', actionable: false, status: 'todo', categories: ['ld'], categoryLabels: ['Level Design'], categoryLabelsZh: ['关卡设计'], title: 'Obstacle Intuition (Bounce/Funnel)', titleZh: '障碍物直觉（弹跳板/漏斗）', desc: 'Funnel hole design is misleading (looks like a challenge, is actually a trap). Bounce pads don\'t read as pads at a glance; flat pads are not intuitive, angled ones are better.', descZh: '漏斗洞口有误导性（看似挑战实为陷阱）。跳跃板乍看缺乏辨识度；平底跳板不直观，带角度的更好。' },
            { id: 'ld_3', actionable: false, status: 'todo', categories: ['ld'], categoryLabels: ['Level Design'], categoryLabelsZh: ['关卡设计'], title: 'Cableways & Shortcuts', titleZh: '缆车与捷径', desc: 'Pipe shortcuts look like static meshes (need boost pads/cues). Cableway entrances need better conveyance; playtesters are getting sucked into Track 2 cableways unintentionally.', descZh: '管道捷径像静态背景（需要加速带提示）。缆车入口需要更好的引导；测试者总是意外被吸进Track 2的缆车。' },
            { id: 'ld_4', actionable: false, status: 'todo', categories: ['ld'], categoryLabels: ['Level Design'], categoryLabelsZh: ['关卡设计'], title: 'Track Flow & Pacing', titleZh: '赛道流畅度与节奏', desc: 'Ribbon road is mechanically punishing. Track 3 tight turns feel "pinchy" (needs "surfing" flow). Tunnel 1 works better than Tunnel 2 (analyze differences, add "end caps"). Sharp turns lack high walls.', descZh: '彩带路机制惩罚性太强。Track 3急弯感觉很卡（需要冲浪般的流畅感）。隧道1体验优于隧道2（需分析差异）。急弯缺乏高墙护栏。' },
            { id: 'ld_5', actionable: false, status: 'todo', categories: ['ld'], categoryLabels: ['Level Design'], categoryLabelsZh: ['关卡设计'], title: 'Onboarding / Tutorialization', titleZh: '新手引导与教学', desc: 'Ideally, bounce pads, shortcuts, cableways, and items should be taught 1 at a time in a relatively safe environment for new players.', descZh: '理想情况下，跳跃板、捷径、缆车和道具应该在相对安全的环境中，逐一教授给新玩家。' },

            // ================= ART & AUDIO =================
            { id: 'art_1', actionable: false, status: 'todo', categories: ['art'], categoryLabels: ['Art'], categoryLabelsZh: ['美术'], title: 'Textures & Toy Theme Readability', titleZh: '材质与玩具主题识别度', desc: 'Materials look "untextured" (textures too fine). Color scheme didn\'t sell "Toy Factory" vibe. Soft plastics recommended over hard surfaces (reduces lighting artifacts). Blue carpet vibe praised.', descZh: '材质像“未贴图”（纹理太细）。配色未体现“玩具工厂”感。建议使用软塑料而非硬表面（可减少光照瑕疵）。蓝色地毯氛围受好评。' },
            { id: 'art_2', actionable: false, status: 'todo', categories: ['art'], categoryLabels: ['Art'], categoryLabelsZh: ['美术'], title: 'Lighting & Environment Artifacts', titleZh: '光照与环境画面瑕疵', desc: 'Levels overexposed with flashing shadows on objects. Fuzzy/blurry textures around the orb on Track 2. Texture issues on floors near giant gears on Track 2.', descZh: '关卡过度曝光，物体有闪烁阴影。Track 2球体周围有模糊纹理。Track 2巨型齿轮附近地面纹理错误。' },
            { id: 'art_3', actionable: false, status: 'todo', categories: ['art'], categoryLabels: ['Art'], categoryLabelsZh: ['美术'], title: 'Character & Model Inconsistencies', titleZh: '角色与模型不一致', desc: 'Playtesters couldn\'t tell which character they were. Ghost vehicle face confuses players/hides hamster. Soldier kart spawns sideways. Polished env models lack materials compared to demo. Ramps still use primitive proxies.', descZh: '玩家分不清自己选了谁。幽灵车脸部遮挡仓鼠。士兵车侧向生成。精细环境模型缺乏材质（相比demo）。坡道仍使用原始白模。' },
            { id: 'art_4', actionable: false, status: 'todo', categories: ['art', 'items'], categoryLabels: ['Art', 'Items'], categoryLabelsZh: ['美术', '道具'], title: 'Item Box Visibility', titleZh: '道具箱可见度', desc: 'New item box design blends into the background. Box is covered in floating dots, making it difficult to identify at a glance.', descZh: '新道具箱设计融入了背景。箱体被漂浮点覆盖，难以一眼识别。' },
            { id: 'aud_1', actionable: false, status: 'todo', categories: ['audio'], categoryLabels: ['Audio'], categoryLabelsZh: ['音效'], title: 'Audio Conveyance & Music Bugs', titleZh: '音效传达与音乐Bug', desc: 'Engine sounds are too dominating. Crucial feedback sounds (items, launchers) are missing/too quiet. Background music occasionally stops completely.', descZh: '引擎声太大。关键反馈音（道具、发射器）丢失或音量太小。背景音乐偶尔会完全停止。' },

            // ================= TECH, BUGS & UI =================
            { id: 'tech_1', actionable: false, status: 'todo', categories: ['tech'], categoryLabels: ['Tech'], categoryLabelsZh: ['技术'], title: 'Critical Bugs & Crashes', titleZh: '严重Bug与崩溃', desc: 'Fatal error on spiral on Track 3. Players get stuck on Lap 2. Wrong way indicator gets stuck halfway on screen. D20 UI freezing made players think all items were broken.', descZh: 'Track 3螺旋路段引发致命错误。玩家卡在第2圈。逆行指示器卡在屏幕中间。D20 UI冻结让玩家以为道具系统全坏了。' },
            { id: 'tech_2', actionable: false, status: 'todo', categories: ['tech'], categoryLabels: ['Tech'], categoryLabelsZh: ['技术'], title: 'Performance & Optimization', titleZh: '性能与优化', desc: '"A smooth 30 FPS is better than a spikey 60 FPS". Huge frame rate drop in 4/16 build caused by tunnel. Lowest FPS hit 2. Vsync screen tear in all levels. Periodic large stutters reported.', descZh: '“稳定30帧好过波动的60帧”。4/16版本隧道导致帧率暴跌至2帧。所有关卡均有画面撕裂。报告有周期性大卡顿。' },
            { id: 'tech_3', actionable: false, status: 'todo', categories: ['tech'], categoryLabels: ['Tech'], categoryLabelsZh: ['技术'], title: 'Collision & Despawn Logic', titleZh: '碰撞与卸载逻辑', desc: 'No collision on Track 2 gears. No collision on certain environment rings after falling off track. Colored environment balls disappear/despawn right in front of the player.', descZh: 'Track 2齿轮无碰撞体积。掉出赛道后某些环境环无碰撞。彩色环境球在玩家面前凭空消失卸载。' },
            { id: 'ui_1', actionable: false, status: 'todo', categories: ['ui'], categoryLabels: ['UI'], categoryLabelsZh: ['界面'], title: 'Multiplayer & Screen Scaling', titleZh: '多人游戏与屏幕缩放', desc: 'UI does not scale in multiplayer (Recommend cutting mini-map). Need better conveyance of who is playing which character in split-screen. Jetpack/AI not seen in 4 player demo.', descZh: '多人模式UI不缩放（建议砍掉小地图）。分屏模式需要更好地提示谁在控制谁。4人demo中未看到喷气背包/AI。' },
            { id: 'ui_2', actionable: false, status: 'todo', categories: ['ui', 'art'], categoryLabels: ['UI', 'Art'], categoryLabelsZh: ['界面', '美术'], title: 'HUD Conveyance & Visual Effects', titleZh: 'HUD传达与视觉特效', desc: 'Conveyance of items succeeding/failing/incoming to target needs clear UI display. Visual effect needed on HUD for boosting. Placement fonts need Gold/Silver/Bronze styling.', descZh: '道具成功/失败/来袭需要清晰的UI显示。加速时HUD需要视觉特效。名次字体需要金/银/铜样式。' },
            { id: 'ui_3', actionable: false, status: 'todo', categories: ['ui'], categoryLabels: ['UI'], categoryLabelsZh: ['界面'], title: 'Menu & Pre-Race Flow', titleZh: '菜单与赛前流程', desc: 'Kart confirmation not clear in selection screen. Players start races in a gaggle. Need to preview the level before starting in Grand Prix mode. Levels need to be named and displayed.', descZh: '选车界面确认状态不清晰。玩家起步挤成一团。大奖赛开始前需预览关卡。关卡需要命名并展示出来。' }
        ];

        let allFeedbacks = [];
        let currentFilter = 'all';
        let itemToDelete = null;

        window.onload = () => {
            loadFeedbacks();
            // i18n initialization
            updateStaticTexts();
            renderGrid();

            // 监听 Checkbox 控制下拉框显示隐藏
            document.getElementById('fb-actionable').addEventListener('change', function() {
                document.getElementById('status-container').classList.toggle('hidden', !this.checked);
            });
        };

        // 切换语言逻辑
        function toggleLanguage() {
            currentLang = currentLang === 'en' ? 'zh' : 'en';
            updateStaticTexts();
            renderGrid();
        }

        // 更新静态页面词汇
        function updateStaticTexts() {
            document.getElementById('main-title').innerText = i18n[currentLang].mainTitle;
            document.getElementById('add-fb-text').innerText = i18n[currentLang].addFb;
            document.getElementById('flt-all').innerText = i18n[currentLang].fltAll;
            document.getElementById('flt-camera').innerText = i18n[currentLang].fltCamera;
            document.getElementById('flt-controls').innerText = i18n[currentLang].fltControls;
            document.getElementById('flt-ld').innerText = i18n[currentLang].fltLd;
            document.getElementById('flt-art').innerText = i18n[currentLang].fltArt;
            document.getElementById('flt-audio').innerText = i18n[currentLang].fltAudio;
            document.getElementById('flt-tech').innerText = i18n[currentLang].fltTech;
            document.getElementById('flt-items').innerText = i18n[currentLang].fltItems;
            document.getElementById('flt-ui').innerText = i18n[currentLang].fltUi;
            document.getElementById('delete-confirm-text').innerText = i18n[currentLang].deleteConfirm;
            document.getElementById('modal-action-text').innerText = i18n[currentLang].markAction;
            document.getElementById('modal-cat-title').innerText = i18n[currentLang].modalCat;
            document.getElementById('modal-title-input').innerText = i18n[currentLang].modalTitle;
            document.getElementById('modal-desc-input').innerText = i18n[currentLang].modalDesc;
            document.getElementById('modal-btn-cancel').innerText = i18n[currentLang].btnCancel;
            document.getElementById('modal-btn-save').innerText = i18n[currentLang].btnSave;
            document.getElementById('del-btn-cancel').innerText = i18n[currentLang].btnCancel;
            document.getElementById('del-btn-confirm').innerText = i18n[currentLang].btnDelete;
            
            // Status update in modal
            document.getElementById('modal-status-label').innerText = i18n[currentLang].statusLabel;
            document.getElementById('modal-status-todo').innerText = i18n[currentLang].statusTodo;
            document.getElementById('modal-status-inprogress').innerText = i18n[currentLang].statusInprogress;
            document.getElementById('modal-status-review').innerText = i18n[currentLang].statusReview;
            document.getElementById('modal-status-done').innerText = i18n[currentLang].statusDone;

            document.querySelector('.i18n-cat-camera').innerText = i18n[currentLang].fltCamera;
            document.querySelector('.i18n-cat-controls').innerText = i18n[currentLang].fltControls;
            document.querySelector('.i18n-cat-ld').innerText = i18n[currentLang].fltLd;
            document.querySelector('.i18n-cat-art').innerText = i18n[currentLang].fltArt;
            document.querySelector('.i18n-cat-audio').innerText = i18n[currentLang].fltAudio;
            document.querySelector('.i18n-cat-tech').innerText = i18n[currentLang].fltTech;
            document.querySelector('.i18n-cat-items').innerText = i18n[currentLang].fltItems;
            document.querySelector('.i18n-cat-ui').innerText = i18n[currentLang].fltUi;
        }

        // 数据加载与兼容迁移
        function loadFeedbacks() {
            const savedData = localStorage.getItem('tgp2_master_feedbacks');
            if (savedData) {
                let parsedData = JSON.parse(savedData);
                
                parsedData = parsedData.map(item => {
                    // Backward compatibility logic
                    if (item.category && typeof item.category === 'string') {
                        item.categories = [item.category];
                        item.categoryLabels = [item.categoryLabel];
                        delete item.category;
                        delete item.categoryLabel;
                    }
                    if (item.categories) {
                        item.categories = item.categories.map(c => {
                            if(c === 'Audio' || c === 'UI' || c === 'Items' || c === 'Tech') return c.toLowerCase();
                            return c;
                        });
                    }
                    if (typeof item.actionable === 'undefined') item.actionable = false;
                    
                    // 新增：自动赋予防崩溃的初始状态属性
                    if (typeof item.status === 'undefined') item.status = 'todo';
                    return item;
                });

                allFeedbacks = parsedData;

                defaultFeedbacks.forEach(defItem => {
                    if (!allFeedbacks.find(fb => fb.id === defItem.id)) {
                        allFeedbacks.unshift(defItem); 
                    }
                });
            } else {
                allFeedbacks = JSON.parse(JSON.stringify(defaultFeedbacks)); // Deep copy
            }
            saveToStorage();
        }

        function saveToStorage() {
            localStorage.setItem('tgp2_master_feedbacks', JSON.stringify(allFeedbacks));
        }

        // 切换星标状态
        function toggleActionable(id) {
            const index = allFeedbacks.findIndex(fb => fb.id === id);
            if (index !== -1) {
                allFeedbacks[index].actionable = !allFeedbacks[index].actionable;
                // 如果刚刚被标记为行动项且没有状态，默认给个todo
                if (allFeedbacks[index].actionable && !allFeedbacks[index].status) {
                    allFeedbacks[index].status = 'todo';
                }
                saveToStorage();
                renderGrid();
            }
        }

        // 直接在卡片上更新开发状态 / Update status directly from card dropdown
        function updateStatus(id, newStatus) {
            const index = allFeedbacks.findIndex(fb => fb.id === id);
            if (index !== -1) {
                allFeedbacks[index].status = newStatus;
                saveToStorage();
                renderGrid();
            }
        }

        // 渲染网格视图
        function renderGrid() {
            const grid = document.getElementById('feedback-grid');
            grid.innerHTML = ''; 

            const groupedFeedbacks = [...allFeedbacks].sort((a, b) => {
                const aAction = a.actionable ? 1 : 0;
                const bAction = b.actionable ? 1 : 0;
                if (aAction !== bAction) return bAction - aAction;

                const labelA = (a.categoryLabels && a.categoryLabels.length > 0) ? a.categoryLabels[0] : '';
                const labelB = (b.categoryLabels && b.categoryLabels.length > 0) ? b.categoryLabels[0] : '';
                return labelA.localeCompare(labelB);
            });

            groupedFeedbacks.forEach(item => {
                if (currentFilter !== 'all' && (!item.categories || !item.categories.includes(currentFilter))) return;

                const card = document.createElement('div');
                const borderColorClass = item.actionable ? 'border-[#fb8500] shadow-[0_0_10px_rgba(251,133,0,0.2)]' : 'border-gray-700';
                const opacityClass = (item.actionable && item.status === 'done') ? 'is-done' : ''; // 完成变灰透明
                card.className = `card rounded-xl p-5 flex flex-col gap-3 border ${borderColorClass} ${opacityClass} relative group`;

                const displayTitle = (currentLang === 'zh' && item.titleZh) ? item.titleZh : item.title;
                const displayDesc = (currentLang === 'zh' && item.descZh) ? item.descZh : item.desc;

                let tagsHtml = (item.categories || []).map((cat, idx) => {
                    const label = (currentLang === 'zh' && item.categoryLabelsZh && item.categoryLabelsZh[idx]) ? item.categoryLabelsZh[idx] : item.categoryLabels[idx];
                    return `<span class="tag ${cat}">${label}</span>`;
                }).join('');

                // 渲染 Action Item 标识与 Kanban 状态下拉框 / Render Action Item & Kanban Status Select
                let topBadgesHtml = '';
                if (item.actionable) {
                    topBadgesHtml = `
                        <div class="flex items-center flex-wrap gap-2 mb-2 w-full">
                            <span class="tag action-item m-0">${i18n[currentLang].actionItem}</span>
                            <select onchange="updateStatus('${item.id}', this.value)" class="status-select status-${item.status || 'todo'}">
                                <option value="todo" ${item.status === 'todo' ? 'selected' : ''}>${i18n[currentLang].statusTodo}</option>
                                <option value="inprogress" ${item.status === 'inprogress' ? 'selected' : ''}>${i18n[currentLang].statusInprogress}</option>
                                <option value="review" ${item.status === 'review' ? 'selected' : ''}>${i18n[currentLang].statusReview}</option>
                                <option value="done" ${item.status === 'done' ? 'selected' : ''}>${i18n[currentLang].statusDone}</option>
                            </select>
                        </div>
                    `;
                }

                const starSvg = item.actionable 
                    ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`;

                const starColor = item.actionable ? 'text-[#fb8500]' : 'text-gray-400';

                card.innerHTML = `
                    ${topBadgesHtml}
                    <div class="flex justify-between items-start">
                        <div class="flex flex-wrap flex-1">${tagsHtml}</div>
                        <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity ml-2">
                            <button onclick="toggleActionable('${item.id}')" class="${starColor} hover:text-[#fb8500] transition-colors cursor-pointer" title="Toggle Action Item">
                                ${starSvg}
                            </button>
                            <button onclick="openModal('${item.id}')" class="text-gray-400 hover:text-[#fb8500] transition-colors cursor-pointer" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg>
                            </button>
                            <button onclick="triggerDelete('${item.id}')" class="text-gray-400 hover:text-red-500 transition-colors cursor-pointer" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                            </button>
                        </div>
                    </div>
                    <h3 class="text-lg font-bold text-white leading-tight mt-1">${displayTitle}</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">${displayDesc}</p>
                `;
                grid.appendChild(card);
            });
        }

        function filterSelection(category) {
            currentFilter = category;
            
            const btns = document.querySelectorAll('.filter-btn');
            btns.forEach(btn => {
                btn.classList.remove('active');
                const onclickText = btn.getAttribute('onclick');
                if (onclickText.includes(`'${category}'`)) {
                    btn.classList.add('active');
                }
            });

            renderGrid();
        }

        // 模态框逻辑
        const modal = document.getElementById('addModal');
        const form = document.getElementById('feedbackForm');

        function openModal(id = null) {
            const titleEl = document.getElementById('modal-title');
            const idInput = document.getElementById('fb-id');
            const actionableInput = document.getElementById('fb-actionable');
            const statusContainer = document.getElementById('status-container');
            const statusInput = document.getElementById('fb-status');
            const errorMsg = document.getElementById('cat-error');
            const checkboxes = document.querySelectorAll('.category-checkbox');
            
            errorMsg.classList.add('hidden');
            checkboxes.forEach(cb => cb.checked = false); 
            actionableInput.checked = false;
            statusContainer.classList.add('hidden');
            statusInput.value = 'todo';
            
            if (id && typeof id === 'string') {
                titleEl.innerText = i18n[currentLang].modalEdit;
                const item = allFeedbacks.find(fb => fb.id === id);
                if (item) {
                    idInput.value = item.id;
                    document.getElementById('fb-title').value = item.title;
                    document.getElementById('fb-desc').value = item.desc;
                    actionableInput.checked = !!item.actionable;
                    
                    if (item.actionable) {
                        statusContainer.classList.remove('hidden');
                        statusInput.value = item.status || 'todo';
                    }
                    
                    if (item.categories) {
                        checkboxes.forEach(cb => {
                            if (item.categories.includes(cb.value)) cb.checked = true;
                        });
                    }
                }
            } else {
                titleEl.innerText = i18n[currentLang].modalNew;
                idInput.value = "";
                document.getElementById('fb-title').value = "";
                document.getElementById('fb-desc').value = "";
            }
            
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
            document.getElementById('cat-error').classList.add('hidden');
            form.reset(); 
        }

        const delModal = document.getElementById('deleteModal');
        function triggerDelete(id) {
            itemToDelete = id;
            delModal.classList.remove('hidden');
        }

        function closeDeleteModal() {
            itemToDelete = null;
            delModal.classList.add('hidden');
        }

        function confirmDelete() {
            if (itemToDelete) {
                allFeedbacks = allFeedbacks.filter(fb => fb.id !== itemToDelete);
                saveToStorage();
                renderGrid();
                closeDeleteModal();
            }
        }

        // 表单提交
        function submitFeedback(e) {
            e.preventDefault(); 
            
            const errorMsg = document.getElementById('cat-error');
            const checkedBoxes = Array.from(document.querySelectorAll('.category-checkbox:checked'));
            
            if (checkedBoxes.length === 0) {
                errorMsg.classList.remove('hidden');
                return;
            }
            errorMsg.classList.add('hidden');

            const idInput = document.getElementById('fb-id').value;
            const isActionable = document.getElementById('fb-actionable').checked;
            const formStatus = document.getElementById('fb-status').value;
            const categories = checkedBoxes.map(cb => cb.value);
            const categoryLabels = checkedBoxes.map(cb => cb.getAttribute('data-label'));
            
            if (idInput) {
                const index = allFeedbacks.findIndex(fb => fb.id === idInput);
                if (index !== -1) {
                    allFeedbacks[index] = {
                        ...allFeedbacks[index],
                        actionable: isActionable,
                        status: isActionable ? formStatus : 'todo', // 若取消星标，自动重置回待办
                        categories: categories,
                        categoryLabels: categoryLabels,
                        title: document.getElementById('fb-title').value,
                        desc: document.getElementById('fb-desc').value
                    };
                }
            } else {
                const newFeedback = {
                    id: 'custom_' + Date.now(),
                    actionable: isActionable,
                    status: isActionable ? formStatus : 'todo',
                    categories: categories,
                    categoryLabels: categoryLabels,
                    title: document.getElementById('fb-title').value,
                    desc: document.getElementById('fb-desc').value
                };
                allFeedbacks.unshift(newFeedback);
            }

            saveToStorage();
            renderGrid();
            closeModal();
        }
    </script>
</body>
</html>
